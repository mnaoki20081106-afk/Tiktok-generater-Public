# SupabaseプロジェクトのURLとanonキー(公開しても安全な値。RLSで保護すること)
# Supabaseダッシュボード > Project Settings > API から取得
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Service Roleキー(絶対に公開しないこと・サーバー専用の秘密鍵)。
# サプライズ抽選の設定(当選確率・当たりURL)や端末記録をRLSの外側で安全に読み書きするために使用する。
# Supabaseダッシュボード > Project Settings > API から取得
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# /admin (サプライズ抽選の管理画面) にアクセスできるGoogleアカウントのメールアドレス。
# カンマ区切りで複数指定可能。
ADMIN_EMAILS=admin@example.com

# 抽選でサイト作成者本人を除外するため、IPアドレスをHMAC化するサーバー専用秘密鍵。
# IPの生値は保存しません。`openssl rand -hex 32` などで64文字のランダム値を生成してください。
# 一度本番で設定した値は変更しないでください（変更すると過去のIPハッシュと照合できなくなります）。
IP_HASH_SECRET=replace-with-at-least-32-random-characters

# YouTube風モードの自動入力で、日本の人気動画情報を取得するためのサーバー専用APIキー。
# Google Cloud ConsoleでYouTube Data API v3を有効化し、APIキーを発行してください。
# HTTPリファラー制限ではなく、利用APIをYouTube Data API v3のみに制限してください。
YOUTUBE_API_KEY=your-youtube-data-api-key

# サイトURL(末尾スラッシュなし)。ローカル/Previewで公開URLを上書きしたい場合に使う。
# Production はコード側で https://post-link.net を正規URLとして固定している。
NEXT_PUBLIC_SITE_URL=https://post-link.net

# リンクジェネレーター(/tools/link-generator)が招待リンクの展開に使うStealth APIのホスト。
# 未設定の場合は既定のCloud RunサービスURLが使われる。
NEXT_PUBLIC_STEALTH_API_HOST=https://apiforurlgenerater-oxsh2xkm7a-an.a.run.app


# X-Bunseki keyword management (server only)
# Fine-grained GitHub token scoped ONLY to mnaoki20081106-afk/X-Bunseki
# Required repository permission: Contents = Read and write
# Never prefix with NEXT_PUBLIC_.
X_BUNSEKI_GITHUB_TOKEN=

# Optional override for monitoring JSON source. Normally leave unset.
X_BUNSEKI_RAW_BASE=
